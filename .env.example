# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# --- Supabase ---
# When these are empty the app falls back to the in-memory demo data source,
# so the Mini App is fully browsable without a database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram ---
# Required in production: initData signatures are verified against this token.
TELEGRAM_BOT_TOKEN=

# Shared secret passed to setWebhook?secret_token=... ; the webhook route
# rejects any call without a matching x-telegram-bot-api-secret-token header.
TELEGRAM_WEBHOOK_SECRET=

# Allows browsing the Mini App outside Telegram during local development.
# Not needed while TELEGRAM_BOT_TOKEN is empty (signatures cannot be verified
# without it, so a demo identity is used automatically outside production).
# MUST stay false (or unset) in production — the app refuses to boot otherwise.
ALLOW_INSECURE_TELEGRAM_AUTH=false

# --- AI provider ---
# mock | anthropic | openai
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# --- Files ---
FILE_DELETE_AFTER_ANALYSIS=true
SUPABASE_UPLOAD_BUCKET=uploads

# --- Admin ---
ADMIN_EMAIL=
